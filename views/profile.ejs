<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profilo - NutriPlan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
    <div class="mobile-topbar" id="mobileTopbar">
        <button class="hamburger-btn" id="sidebarToggle" aria-label="Apri menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
        <a href="/" class="topbar-logo">
            <img src="/img/logo.svg" alt="NutriPlan" class="topbar-logo-img">
            <span class="topbar-logo-text">NutriPlan</span>
        </a>
    </div>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <%- include('partials/sidebar') %>

    <main class="main-content">
        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <div class="profile-header-section">
            <div class="profile-main-info">
                <% if (user.profile_picture) { %>
                    <div class="profile-avatar-large profile-avatar-img">
                        <img src="<%= user.profile_picture %>" alt="Profile">
                    </div>
                <% } else { %>
                    <div class="profile-avatar-large">
                        <%= user.username.charAt(0).toUpperCase() %>
                    </div>
                <% } %>
                <div class="profile-text-info">
                    <h1><%= user.username %></h1>
                    <p class="profile-email"><%= user.email %></p>
                    <p class="profile-meta">Membro dal <%= user.created_at ? new Date(user.created_at).toLocaleDateString('it-IT', { month: 'long', year: 'numeric' }) : 'N/A' %></p>
                </div>
            </div>
            
            <div class="profile-pic-form-inline">
                <div class="profile-pic-buttons">
                    <form action="/profile/update-picture" method="POST" class="update-pic-form">
                        <input type="file" id="profile_picture" name="profile_picture" accept="image/jpeg,image/jpg,image/png,image/webp">
                        <label for="profile_picture" class="btn-secondary btn-sm">Cambia foto</label>
                        <input type="hidden" id="profile_picture_base64" name="profile_picture_base64">
                        <button type="submit" class="btn-primary btn-sm" id="save-pic-btn" style="display: none;">Salva</button>
                        <button type="button" class="btn-ghost btn-sm" id="cancel-pic-btn" style="display: none;">Annulla</button>
                    </form>
                    <% if (user.profile_picture) { %>
                    <form action="/profile/remove-picture" method="POST" class="remove-pic-form" id="removePicForm">
                        <button type="submit" class="btn-ghost btn-sm remove-pic-btn">Rimuovi foto</button>
                    </form>
                    <% } %>
                </div>
                <span class="pic-hint">JPG, PNG o WebP. Max 2MB.</span>
            </div>
        </div>

        <div class="profile-grid">
            <% if (diet) { %>
            <div class="box">
                <h3>Obiettivo e Misure</h3>
                <div class="box-content">
                    <div class="info-row">
                        <span class="info-label">Obiettivo</span>
                        <span class="info-value goal-badge goal-<%= diet.goal %>"><%= diet.goal === 'slim' ? 'Dimagrimento' : 'Massa Muscolare' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">BMI</span>
                        <span class="info-value">
                            <%= diet.bmi %>
                            <% if (bmiCategory) { %>
                                <span class="bmi-category bmi-<%= bmiCategory.toLowerCase().replace(' ', '-') %>"><%= bmiCategory %></span>
                            <% } %>
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Peso attuale</span>
                        <span class="info-value"><%= diet.weight %> kg</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Altezza</span>
                        <span class="info-value"><%= diet.height %> cm</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Peso obiettivo</span>
                        <span class="info-value"><%= diet.target_weight %> kg</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Calorie giornaliere</span>
                        <span class="info-value highlight"><%= diet.calories %> kcal</span>
                    </div>
                </div>
            </div>

            <div class="box macro-box">
                <h3>Macronutrienti</h3>
                <div class="box-content">
                    <div class="macro-progress-list">
                        <div class="macro-progress-item">
                            <div class="macro-progress-header">
                                <span>Proteine</span>
                                <span><%= diet.protein_g %>g</span>
                            </div>
                            <div class="macro-progress-bar">
                                <div class="macro-progress-fill protein" style="width: <%= Math.min(100, (diet.protein_g / 200) * 100) %>%;"></div>
                            </div>
                        </div>
                        <div class="macro-progress-item">
                            <div class="macro-progress-header">
                                <span>Carboidrati</span>
                                <span><%= diet.carbs_g %>g</span>
                            </div>
                            <div class="macro-progress-bar">
                                <div class="macro-progress-fill carbs" style="width: <%= Math.min(100, (diet.carbs_g / 400) * 100) %>%;"></div>
                            </div>
                        </div>
                        <div class="macro-progress-item">
                            <div class="macro-progress-header">
                                <span>Grassi</span>
                                <span><%= diet.fat_g %>g</span>
                            </div>
                            <div class="macro-progress-bar">
                                <div class="macro-progress-fill fat" style="width: <%= Math.min(100, (diet.fat_g / 100) * 100) %>%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% } else { %>
            <div class="box box-empty">
                <h3>Obiettivo e Misure</h3>
                <div class="box-content">
                    <p class="no-data">Nessun obiettivo definito. <a href="/diet/step1">Crea il tuo piano</a></p>
                </div>
            </div>
            <% } %>

            <div class="box">
                <h3>Account</h3>
                <div class="box-content">
                    <div class="info-row">
                        <span class="info-label">Username</span>
                        <span class="info-value"><%= user.username %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Email</span>
                        <span class="info-value"><%= user.email %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Data di nascita</span>
                        <span class="info-value"><%= user.dob %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Età</span>
                        <span class="info-value"><%= user.age %> anni</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Sesso</span>
                        <span class="info-value"><%= user.sex === 'M' ? 'Maschio' : 'Femmina' %></span>
                    </div>
                </div>
                <button type="button" class="btn-secondary btn-sm" id="changePasswordBtn" style="margin-top: 1rem;">Cambia Password</button>
                <div id="passwordChangeForm" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
                    <form action="/profile/change-password" method="POST" class="password-form">
                        <div class="form-group">
                            <label for="currentPassword">Password Attuale</label>
                            <input type="password" id="currentPassword" name="currentPassword" required>
                        </div>
                        <div class="form-group">
                            <label for="newPassword">Nuova Password</label>
                            <input type="password" id="newPassword" name="newPassword" required minlength="6">
                        </div>
                        <div class="form-group">
                            <label for="confirmPassword">Conferma Nuova Password</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6">
                        </div>
                        <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                            <button type="submit" class="btn-primary btn-sm">Salva</button>
                            <button type="button" class="btn-ghost btn-sm" id="cancelPasswordBtn">Annulla</button>
                        </div>
                    </form>
                </div>
            </div>

            <% if (typeof hasPremium !== 'undefined' && hasPremium) { %>
            <div class="box premium-box">
                <h3>Abbonamento</h3>
                <div class="box-content">
                    <div class="premium-status">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        <div>
                            <strong>Premium Attivo</strong>
                            <% if (typeof premiumExpiry !== 'undefined' && premiumExpiry) { %>
                                <span>Scade il <%= new Date(premiumExpiry).toLocaleDateString('it-IT') %></span>
                            <% } %>
                        </div>
                    </div>
                </div>
                <form action="/profile/cancel-premium" method="POST" style="margin-top: 1rem;">
                    <button type="submit" class="btn-ghost btn-sm">Annulla Abbonamento</button>
                </form>
            </div>
            <% } else { %>
            <div class="box free-plan-box">
                <h3>Abbonamento</h3>
                <div class="box-content">
                    <div class="free-plan-status" style="color: #6b7280;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <div>
                            <strong>Piano Base</strong>
                            <span>API Keys: <%= typeof keyCount !== 'undefined' ? keyCount : 0 %>/2</span>
                        </div>
                    </div>
                    <% if (typeof keyCount !== 'undefined' && keyCount >= 2) { %>
                    <div class="free-plan-features">
                        <p style="color: #ef4444;">Limite raggiunto!</p>
                    </div>
                    <% } else { %>
                    <div class="free-plan-features">
                        <p>Passa a Premium per API Keys illimitate.</p>
                    </div>
                    <% } %>
                    <a href="/api-keys/premium" class="btn-premium">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        Passa a Premium - 2€/mese
                    </a>
                </div>
            </div>
            <% } %>
        </div>
    </main>

    <script src="/js/main.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const changePasswordBtn = document.getElementById('changePasswordBtn');
            const passwordChangeForm = document.getElementById('passwordChangeForm');
            const cancelPasswordBtn = document.getElementById('cancelPasswordBtn');

            if (changePasswordBtn) {
                changePasswordBtn.addEventListener('click', function() {
                    passwordChangeForm.style.display = 'block';
                    changePasswordBtn.style.display = 'none';
                });
            }

            if (cancelPasswordBtn) {
                cancelPasswordBtn.addEventListener('click', function() {
                    passwordChangeForm.style.display = 'none';
                    changePasswordBtn.style.display = 'inline-flex';
                    document.getElementById('currentPassword').value = '';
                    document.getElementById('newPassword').value = '';
                    document.getElementById('confirmPassword').value = '';
                });
            }

            const cancelPremiumForm = document.querySelector('form[action="/profile/cancel-premium"]');
            if (cancelPremiumForm) {
                cancelPremiumForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    showConfirm('Sei sicuro di voler annullare il tuo abbonamento Premium?', function() {
                        cancelPremiumForm.submit();
                    });
                });
            }

            const removePicForm = document.getElementById('removePicForm');
            if (removePicForm) {
                removePicForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    showConfirm('Sei sicuro di voler rimuovere la foto profilo?', function() {
                        removePicForm.submit();
                    });
                });
            }
        });
    </script>
</body>
</html>