<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Step 2 - NutriPlan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/diet.css">
    <link rel="stylesheet" href="/css/step2.css">
</head>
<body class="auth-page">
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="nav-logo">
                <img src="/img/logo.svg" alt="NutriPlan" class="logo-img">
                <span>NutriPlan</span>
            </a>
            <div class="nav-links">
                <a href="/dashboard" class="btn-ghost">Dashboard</a>
            </div>
        </div>
    </nav>

    <main class="diet-container">
        <div class="diet-card">
            <div class="diet-header">
                <h1>I tuoi Dati Fisici</h1>
                <p>Inserisci i tuoi dati per calcolare il tuo piano personalizzato</p>
            </div>

            <div id="formError" class="alert alert-error" style="display: none;"></div>

            <% if (error) { %>
                <div class="alert alert-error"><%= error %></div>
            <% } %>

            <form action="/diet/step3" method="GET" class="diet-form" id="dietForm" novalidate>
                <input type="hidden" name="goal" value="<%= goal %>">

                <div class="input-group">
                    <label for="weight">Peso Attuale: <strong id="weightValue">70</strong> kg</label>
                    <div class="slider-wrapper">
                        <input type="range" id="weight" name="weight" min="30" max="200" value="70" step="0.5">
                        <div class="slider-labels">
                            <span>30 kg</span>
                            <span>200 kg</span>
                        </div>
                    </div>
                    <span class="field-error" id="weight-error"></span>
                </div>

                <div class="input-group">
                    <label for="height">Altezza: <strong id="heightValue">170</strong> cm</label>
                    <div class="slider-wrapper">
                        <input type="range" id="height" name="height" min="100" max="220" value="170" step="1">
                        <div class="slider-labels">
                            <span>100 cm</span>
                            <span>220 cm</span>
                        </div>
                    </div>
                    <span class="field-error" id="height-error"></span>
                </div>

                <div class="input-group">
                    <label for="activity">Livello di Attività Fisica</label>
                    <select id="activity" name="activity">
                        <option value="">Seleziona il tuo livello</option>
                        <option value="1">Sedentario (ufficio, poco movimento)</option>
                        <option value="2">Leggermente attivo (esercizio leggero 1-3 giorni/sett)</option>
                        <option value="3">Moderatamente attivo (esercizio moderato 3-5 giorni/sett)</option>
                        <option value="4">Molto attivo (esercizio intenso 6-7 giorni/sett)</option>
                        <option value="5">Estremamente attivo (atleta, lavoro fisico pesante)</option>
                    </select>
                    <span class="field-error" id="activity-error"></span>
                </div>

                <div class="form-actions">
                    <a href="/diet/step1" class="btn-ghost">Indietro</a>
                    <button type="submit" class="btn-primary">Continua</button>
                </div>
            </form>
        </div>
    </main>

    <script src="/js/main.js"></script>
    <script src="/js/step2.js"></script>
</body>
</html>