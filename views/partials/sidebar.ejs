<nav class="sidebar">
    <div class="mobile-header">
        <a href="/" class="logo-link">
            <img src="/img/logo.svg" alt="NutriPlan" class="logo">
            <span class="logo-text">NutriPlan</span>
        </a>
        <button class="mobile-toggle" id="sidebarClose" aria-label="Chiudi menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <div class="sidebar-header sidebar-desktop-only">
        <a href="/" class="logo-link">
            <img src="/img/logo.svg" alt="NutriPlan" class="logo">
            <span class="logo-text">NutriPlan</span>
        </a>
    </div>

    <div class="sidebar-user">
        <% if (user.profile_picture) { %>
            <div class="user-avatar user-avatar-img">
                <img src="<%= user.profile_picture %>" alt="Profile">
            </div>
        <% } else { %>
            <div class="user-avatar">
                <%= user.username.charAt(0).toUpperCase() %>
            </div>
        <% } %>
        <div class="user-info">
            <span class="user-name"><%= user.username %></span>
            <span class="user-email"><%= user.email %></span>
        </div>
    </div>

    <ul class="sidebar-menu">
        <li>
            <a href="/dashboard" class="menu-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                <span>Dashboard</span>
            </a>
        </li>
        <li>
            <a href="/diet/step1" class="menu-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                    <path d="M2 17l10 5 10-5"></path>
                    <path d="M2 12l10 5 10-5"></path>
                </svg>
                <span>Nuovo Piano</span>
            </a>
        </li>
        <li>
            <a href="/tips" class="menu-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
